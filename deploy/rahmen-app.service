[Unit]
Description=Kalender Bilderrahmen (lokale Diashow-App)
After=network.target

[Service]
Type=simple
User=tay
WorkingDirectory=/home/tay/kalender/rahmen
ExecStart=/home/tay/kalender/venv/bin/gunicorn -w 1 -b 127.0.0.1:8600 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
